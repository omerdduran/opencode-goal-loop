{
  "name": "opencode-goal-loop",
  "version": "0.1.1",
  "description": "Durable, guarded goal loop for OpenCode. Set a goal and the agent auto-continues until it is complete, surviving context compaction.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "opencode-goal-loop": "./dist/verify.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent",
    "goal",
    "autonomous",
    "auto-continue"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omerdduran/opencode-goal-loop.git"
  },
  "homepage": "https://github.com/omerdduran/opencode-goal-loop#readme",
  "bugs": {
    "url": "https://github.com/omerdduran/opencode-goal-loop/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "opencode": ">=1.18.29"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.35",
    "@opencode/plugin": "2.1.2",
    "typescript": "^7.0.2",
    "@types/node": "^26.6.4"
  },
  "dependencies": {
    "zod": "^4.1.8"
  }
}
